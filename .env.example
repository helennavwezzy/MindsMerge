# Neo4j — social graph database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password

# JWT auth
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=some-long-random-secret

# Gemini (agents)
GOOGLE_API_KEY=your-google-api-key

# Google OAuth — only needed for the YouTube agent toolset
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# FalkorDB — only needed for Graphiti notebooks
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Where agents reach the forum MCP server
WFORUM_MCP_URL=http://localhost:8080/mcp
